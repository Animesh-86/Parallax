# Root .gitignore for Parallax project

# OS Files
.DS_Store
Thumbs.db

# IDE Files
.idea/
.vscode/
*.iml
*.iws
*.ipr

# Node.js
**/node_modules/
**/dist/
**/build/
.npm
.yarn-integrity
*.log

# Java
**/target/
.mvn/
mvnw
mvnw.cmd
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache



# Secrets
**/.env
**/.env.local
**/.env.*
!**/.env.example
**/application-local.properties
**/application-*.properties
!**/application-h2.properties
!**/application.properties
**/client_secret_*.json
**/credentials*.json
**/*.key
**/*.pem
**/secrets/

# H2 file-based database
**/data/*.db
**/data/*.mv.db
**/data/*.trace.db
**/data/*.lock.db
