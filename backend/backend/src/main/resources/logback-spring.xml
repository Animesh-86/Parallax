<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- ============================================================
         Parallax — Structured Logging Configuration
         
         Profiles:
         - default/dev: Human-readable console output
         - prod:        JSON structured logs for log aggregation
         ============================================================ -->

    <!-- ====== DEV PROFILE (default) ====== -->
    <springProfile name="default,dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <!-- Security Audit File Appender (tamper-resistant, separate from app logs) -->
        <appender name="SECURITY_AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/security-audit.log</file>
            <append>true</append>
            <encoder>
                <pattern>%msg%n</pattern> <!-- Raw JSON lines -->
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/security-audit.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>90</maxHistory>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>

        <!-- Security Audit Logger — writes to dedicated file, NOT console -->
        <logger name="SECURITY_AUDIT" level="INFO" additivity="false">
            <appender-ref ref="SECURITY_AUDIT_FILE" />
        </logger>

        <!-- Suppress noisy Hibernate SQL in dev (show-sql=false handles JPA layer) -->
        <logger name="org.hibernate.SQL" level="WARN" />
        <logger name="org.hibernate.type.descriptor.sql" level="WARN" />

        <!-- Suppress noisy Spring Security debug -->
        <logger name="org.springframework.security" level="WARN" />

        <!-- Parallax app logs at DEBUG in dev -->
        <logger name="com.parallax" level="DEBUG" />
    </springProfile>

    <!-- ====== PRODUCTION PROFILE ====== -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdc>true</includeMdc>
                <includeContext>false</includeContext>
                <fieldNames>
                    <timestamp>@timestamp</timestamp>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                </fieldNames>
            </encoder>
        </appender>

        <!-- Security Audit File Appender (production — longer retention) -->
        <appender name="SECURITY_AUDIT_FILE_PROD" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/security-audit.log</file>
            <append>true</append>
            <encoder>
                <pattern>%msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/security-audit.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
                <maxHistory>365</maxHistory>
            </rollingPolicy>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE" />
        </root>

        <!-- Security Audit Logger (production) -->
        <logger name="SECURITY_AUDIT" level="INFO" additivity="false">
            <appender-ref ref="SECURITY_AUDIT_FILE_PROD" />
        </logger>

        <!-- Suppress noisy loggers in production -->
        <logger name="org.hibernate.SQL" level="WARN" />
        <logger name="org.springframework.security" level="WARN" />
        <logger name="org.apache.catalina" level="WARN" />

        <!-- Parallax app at INFO in production -->
        <logger name="com.parallax" level="INFO" />
    </springProfile>
</configuration>
